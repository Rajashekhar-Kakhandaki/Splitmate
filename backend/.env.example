# -----------------------------------------------------------------------------
# SplitMate Production Environment Variables Template
# 
# Instructions:
# 1. Copy this file to `.env` (or add these to your cloud provider's dashboard)
# 2. Replace all the dummy values with your actual production keys.
# -----------------------------------------------------------------------------

# [REQUIRED] Database Connection
# Replace with your managed cloud database URL (e.g. Supabase, Neon, AWS RDS)
DATABASE_URL="postgresql://user:password@host:5432/splitmate"

# [REQUIRED] Security
# Generate a long, random string for signing JSON Web Tokens
JWT_SECRET="generate-a-very-long-random-string-here"
JWT_EXPIRES_IN="7d"

# [REQUIRED] App Configuration
# The port the API will listen on (usually handled automatically by cloud providers)
PORT=5000
# The URL where your frontend is hosted (e.g., https://splitmate.vercel.app)
CLIENT_URL="http://localhost:5173"

# =============================================================================
# OPTIONAL INTEGRATIONS 
# (If omitted, the app will gracefully fallback to local behavior)
# =============================================================================

# [OPTIONAL] Cloudinary (For persistent image hosting)
# If omitted, uploads will be saved to the local disk (not recommended for serverless)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL="cloudinary://my_api_key:my_api_secret@my_cloud_name"

# [OPTIONAL] Nodemailer / SMTP (For real password reset emails)
# If omitted, password reset links will just be printed to the server console.
# Works with Resend, SendGrid, Mailgun, or standard SMTP.
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASS="re_123456789"
SMTP_FROM="onboarding@resend.dev"
